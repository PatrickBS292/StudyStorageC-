@model StudentManager.Models.Student
<h1>Opret Studerende</h1>
<form method="post">
    <div>
        <label>Navn</label>
        <input type="text" name="Name" />
    </div>

    <div>
        <label>Education</label>
        <input type="text" name="Education" />
    </div>

